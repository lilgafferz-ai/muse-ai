{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "Muse AI Companion",
  "version": "1.0.0",
  "identifier": "com.museai.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd .. && npm run build",
    "beforeDevCommand": "cd .. && npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Muse",
        "width": 1000,
        "height": 700,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "decorations": true,
        "resizable": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' http://localhost:3001 http://localhost:* https://api.openrouter.ai https://*.duckduckgo.com; img-src 'self' data: https:; script-src 'self'; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "tray-icon": {
      "iconPath": "icons/32x32.png"
    },
    "global-shortcut": {
      "shortcuts": {
        "toggleWindow": "Ctrl+Shift+M",
        "activateMuse": "Ctrl+Shift+Space"
      }
    },
    "notification": {
      "all": true
    },
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "powershell",
          "cmd": "powershell",
          "args": true
        },
        {
          "name": "cmd",
          "cmd": "cmd",
          "args": true
        }
      ]
    }
  }
}
