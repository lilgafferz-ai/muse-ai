{
  "identifier": "default",
  "description": "Default capabilities for Muse desktop app",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "shell:allow-execute",
    "shell:allow-open",
    "global-shortcut:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "notification:default",
    "notification:allow-notify",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "process:default",
    "process:allow-exit"
  ]
}
