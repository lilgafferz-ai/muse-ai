# MongoDB Connection (Local or Atlas)
# For local MongoDB: mongodb://localhost:27017/muse
# For MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster0.xxxxx.mongodb.net/muse
MONGODB_URI=mongodb://localhost:27017/muse

# Server Port
PORT=3001

# Ollama (Local AI)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ChromaDB
CHROMA_PATH=./chroma_db
