# ─── AI Provider ───────────────────────────────
# Choose between 'ollama' (local) or 'openrouter' (cloud)
AI_PROVIDER=ollama

# ─── Ollama (Local AI) ─────────────────────────
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── OpenRouter (Cloud AI) ─────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# ─── Database ──────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/muse

# ─── Vector Memory (ChromaDB) ──────────────────
# Optional: Only needed if you run a ChromaDB server
CHROMA_SERVER_URL=http://localhost:8000

# ─── Server ────────────────────────────────────
PORT=3001
